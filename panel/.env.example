# Ejemplo sin credenciales. Guardar valores reales solo en el alojamiento privado.
# No confundir con GitHub Secrets: el servidor necesita su propia configuración.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Ejemplo de formato del origen: https://control.su-dominio.com (sin barra final).
PANEL_ORIGIN=
# Correo confirmado del único operador; alta diferida por decisión del propietario.
PANEL_OPERATOR_EMAILS=
# No se usa SUPABASE_DB_URL, SUPABASE_BACKUP_KEY ni APIFY_TOKEN en el servidor web.
